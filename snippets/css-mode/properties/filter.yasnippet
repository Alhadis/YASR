filter: url('data:image/svg+xml,\\
	<?xml version="1.0" encoding="utf-8"?>\\
	<svg version="1.1" xmlns="http://www.w3.org/2000/svg">\\
		<filter id="f">\\
			${1:<feFlood flood-color="%23ff0" result="a"/>\\
