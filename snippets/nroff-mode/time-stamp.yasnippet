# -*- mode: snippet -*-
# key: timestamp
# name: Emacs file-local variables for updating mdoc(7) Dd macro
# atom-selector: .text.roff
# --
.\\" Local variables:
.\\" coding: utf-8
.\\" eval: (add-hook 'before-save-hook 'time-stamp)
.\\" time-stamp-start: "^\\\\.[	]*Dd +"
.\\" time-stamp-format: "%:B %d, %Y"
.\\" time-stamp-end: "[ 	]*$"
.\\" time-stamp-time-zone: nil
.\\" End: