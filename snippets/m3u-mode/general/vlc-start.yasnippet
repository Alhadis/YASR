# -*- mode: snippet -*-
# key: start
# name: Set media start-time in VLC
# group: General
# atom-selector: .source.m3u
# atom-description: Time is specified in seconds; i.e., two minutes is 120
# atom-description-more-url: https://www.vlchelp.com/skipping-and-playing-audio-and-video-portions-in-vlc/
# --
#EXTVLCOPT:start-time=${1:0.0}